# Public build config. No-account mode: nobody signs in, every database call is answered
# in the browser (src/lib/localDb.js). The URL is a stand-in the interceptor claims.
# To connect a real Supabase project later: set VITE_DEMO=false and fill in the two values.
VITE_DEMO=true
VITE_SUPABASE_URL=https://local.limitless-scrum.invalid
VITE_SUPABASE_ANON_KEY=local
