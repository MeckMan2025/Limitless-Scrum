# The build that runs on the robotics server (Dockerfile). People sign in, and
# everything is kept by the app's own server (server/), so every account and
# computer sees the same boards, calendar and settings.
# same-origin: the API is <base>api on whatever address the page was opened from.
VITE_DEMO=false
VITE_BASE=/scrum/
VITE_SUPABASE_URL=same-origin
# Not a secret: the server identifies people by their sign-in token, not by this.
VITE_SUPABASE_ANON_KEY=limitless-public
